digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.32, fontname="DejaVu Sans", bgcolor="white", pad=0.3,
         label=<<B>Proposed Protocol v8-Chain — Operation per Round</B>>, labelloc=t, fontsize=22, fontcolor="#1F4E78"];
  node  [fontname="DejaVu Sans", fontsize=13, shape=box, style="rounded,filled", color="#1F4E78", penwidth=1.4, fillcolor="#FFFFFF", margin="0.18,0.08"];
  edge  [color="#404040", penwidth=1.3, arrowsize=0.8, fontname="DejaVu Sans", fontsize=12];

  start  [label="Start: 100 nodes, E0 = 0.5 J", shape=ellipse, fillcolor="#1F4E78", fontcolor="white"];
  round  [label="Round r", fillcolor="#DCE6F1"];
  setup  [label="Setup round?\n(every 5 rounds)", shape=diamond, fillcolor="#DCE6F1", margin="0.05,0.05"];

  subgraph cluster_setup {
    label=<<B>SETUP PHASE</B> (once per 5 rounds)>; fontsize=15; fontcolor="#1F4E78"; style="rounded,dashed"; color="#1F4E78";
    s1 [label=<Epoch exhausted (every alive node already served)?<BR/>→ start a new epoch  <B>[I1]</B>>, fillcolor="#E2EFDA"];
    s2 [label=<Eligible = alive, not CH in this epoch,<BR/>energy ≥ network average  <B>[I5]</B>>, fillcolor="#E2EFDA"];
    s3 [label=<score = (E / E0) × (1 + degree / maxDegree)<BR/>P(CH) = min(1, T(r) × score)  <B>[LEACH + HEED]</B>>, fillcolor="#F2F2F2"];
    s4 [label=<CHs advertise → each node joins the nearest CH  <B>[LEACH]</B>>, fillcolor="#F2F2F2"];
    s5 [label=<Each CH designates a Backup =<BR/>highest-energy member of its cluster  <B>[v5]</B>>, fillcolor="#F2F2F2"];
    s1 -> s2 -> s3 -> s4 -> s5;
  }

  subgraph cluster_round {
    label=<<B>STEADY-STATE PHASE</B> (every round)>; fontsize=15; fontcolor="#1F4E78"; style="rounded,dashed"; color="#1F4E78";
    r1 [label=<Members whose CH died → re-join nearest alive CH  <B>[I3]</B>>, fillcolor="#E2EFDA"];
    r2 [label=<Each CH picks its next hop: relay via a CH closer to the BS<BR/><I>only if cheaper than sending direct</I>  <B>[Chain]</B>>, fillcolor="#FCE4D6"];
    r3 [label="CH energy < this round's\nCH workload?", shape=diamond, fillcolor="#FFFFFF", margin="0.05,0.05"];
    r3y [label=<Hand CH role to strongest member<BR/>while still alive  <B>[I2]</B>>, fillcolor="#E2EFDA"];
    r4 [label="Member: distance to BS\n≤ distance to its CH?", shape=diamond, fillcolor="#FFFFFF", margin="0.05,0.05"];
    r4y [label=<Send directly to BS  <B>[I4]</B>>, fillcolor="#E2EFDA"];
    r4n [label="Send data to CH", fillcolor="#F2F2F2"];
    r5 [label=<CHs (farthest from BS first) aggregate own members + relayed data<BR/>and forward one packet to next hop or BS  <B>[Chain]</B>>, fillcolor="#FCE4D6"];
    r6 [label="CH died\nunexpectedly?", shape=diamond, fillcolor="#FFFFFF", margin="0.05,0.05"];
    r6y [label=<Backup promoted, members reconnected;<BR/>it takes the dead CH's place in the relay path<BR/>(low-energy test relative to network average)  <B>[v5 + fix]</B>>, fillcolor="#E2EFDA"];
    r1 -> r2 -> r3;
    r3 -> r3y [xlabel=" yes "];
    r3 -> r4 [xlabel=" no "];
    r3y -> r4;
    r4 -> r4y [xlabel=" yes "];
    r4 -> r4n [xlabel=" no "];
    r4n -> r5;
    r4y -> upd [style=dashed, xlabel=" bypasses CH "];
    r5 -> r6;
    r6 -> r6y [xlabel=" yes "];
  }

  upd  [label="Update energy, FND / HND / LND, PDR", fillcolor="#DCE6F1"];
  more [label="Alive nodes > 0?", shape=diamond, fillcolor="#DCE6F1", margin="0.05,0.05"];
  stop [label="End", shape=ellipse, fillcolor="#1F4E78", fontcolor="white"];

  start -> round -> setup;
  setup -> s1 [xlabel=" yes "];
  setup -> r1 [xlabel=" no "];
  s5 -> r1;
  r6 -> upd [xlabel=" no "];
  r6y -> upd;
  upd -> more;
  more -> round [xlabel=" yes, r+1 ", constraint=false];
  more -> stop [xlabel=" no "];

  subgraph cluster_legend {
    label=<<B>Legend</B>>; fontsize=13; style="rounded"; color="#A6A6A6";
    l1 [label="Inherited (LEACH / HEED / v3 / v5)", fillcolor="#F2F2F2", fontsize=11];
    l2 [label="New in v8", fillcolor="#E2EFDA", fontsize=11];
    l3 [label="New in v8-Chain", fillcolor="#FCE4D6", fontsize=11];
    l1 -> l2 -> l3 [style=invis];
  }
}
